rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function validateString(val) {
      return val is string && val.size() > 0 && val.size() <= 1000;
    }

    function validatePositiveNumber(val) {
      return (val is number || val is int) && val > 0;
    }

    function validateNonNegativeNumber(val) {
      return (val is number || val is int) && val >= 0;
    }

    function isEmployee() {
      return isSignedIn() && request.auth.token.role == 'Employee';
    }

    function isAdmin() {
       return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Global Validation Helpers
    function validateInput(val, max) {
      return val is string && val.size() <= max;
    }

    // 1. USERS: Only users can read & write their own account
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. PRODUCTS: Validate: name string, price > 0, stock >= 0, ownerId required
    match /products/{productId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validateInput(request.resource.data.name, 500) &&
                    !request.resource.data.name.matches('.*<script.*') &&
                    validatePositiveNumber(request.resource.data.price) &&
                    validateNonNegativeNumber(request.resource.data.stock);
      allow update: if isSignedIn() && 
                    isOwner(resource.data.ownerId) &&
                    isOwner(request.resource.data.ownerId) &&
                    validateInput(request.resource.data.name, 500) &&
                    !request.resource.data.name.matches('.*<script.*') &&
                    validatePositiveNumber(request.resource.data.price) &&
                    validateNonNegativeNumber(request.resource.data.stock) &&
                    (request.time < resource.data.updatedAt + duration.value(1, 's')); 
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // 3. ACTIVITIES: Read by owner, write-only/create-only, write once, NO edit/delete
    match /activities/{activityId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId) && validateInput(request.resource.data.action, 500);
      allow update, delete: if false; 
    }

    // 4. SALES: Total > 0, quantity >= 1, ownerId required
    match /sales/{saleId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validatePositiveNumber(request.resource.data.total) &&
                    validatePositiveNumber(request.resource.data.quantity);
      allow update, delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // NEW: ATTENDANCE
    match /attendance/{atId} {
      allow read: if isSignedIn() && (isOwner(resource.data.ownerId) || request.auth.uid == resource.data.employeeId);
      allow create: if isEmployee() && 
                    request.resource.data.employeeEmail == request.auth.token.email &&
                    request.resource.data.checkInTime is string &&
                    request.resource.data.status in ['present', 'late', 'absent'];
      allow update, delete: if false;
    }

    // NEW: SECURITY EVENTS (Append-only by server, read by owner)
    match /securityEvents/{eventId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // NEW: SECURITY REPORTS
    match /securityReports/{reportId} {
      allow read: if isSignedIn() && isOwner(resource.data.ownerId);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 5. EXPENSES: Amount > 0, category required string
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validatePositiveNumber(request.resource.data.amount) &&
                    validateString(request.resource.data.category);
      allow update: if isSignedIn() && 
                    isOwner(resource.data.ownerId) &&
                    isOwner(request.resource.data.ownerId) &&
                    validatePositiveNumber(request.resource.data.amount) &&
                    validateString(request.resource.data.category);
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // 6. CUSTOMERS: Name string, phone optional string
    match /customers/{customerId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validateString(request.resource.data.name) &&
                    (request.resource.data.phone == null || request.resource.data.phone is string);
      allow update: if isSignedIn() && 
                    isOwner(resource.data.ownerId) &&
                    isOwner(request.resource.data.ownerId) &&
                    validateString(request.resource.data.name) &&
                    (request.resource.data.phone == null || request.resource.data.phone is string);
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // 7. WALLETS (Singular/Plural paths to support full compatibility)
    match /wallets/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /wallet/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 8. LOGIN LOGS: Logged when users authentication events trigger
    match /loginLogs/{logId} {
      allow read, create, delete: if isSignedIn() && 
                    (resource == null || resource.data.userId == request.auth.uid) &&
                    (request.resource == null || request.resource.data.userId == request.auth.uid);
      allow update: if false;
    }
  }
}
